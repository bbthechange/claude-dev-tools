# beads-runner/web/_headers — Cloudflare Pages response headers for the unified
# claude-wrangler app. First match wins; only the paths listed here get extra
# headers (everything else uses Pages defaults).
#
# N2 (claude-tools-uxg1): the Inbox PWA. The service worker must NOT be served
# from a stale cache (a pushed SW update has to take effect promptly), and the
# manifest must carry the correct MIME so the browser treats it as a Web App
# Manifest (installability → Web Push on the installed PWA).

/inbox/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/inbox/manifest.webmanifest
  Content-Type: application/manifest+json

# claude-tools-4zrn: the SHARED offline-read service worker for the NON-Inbox
# pull surfaces (UX-DESIGN-V2 §2.4). Served no-cache so a pushed SW update takes
# effect promptly (same reasoning as the Inbox SW above), and with
# Service-Worker-Allowed: / so it can register at the root scope `/` from its
# /shared/ location and cover every non-Inbox route. The Inbox keeps the
# more-specific /inbox/ scope, so this never controls the live Inbox surface.
/shared/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
