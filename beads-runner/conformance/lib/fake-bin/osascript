#!/bin/bash
# Conformance harness — osascript stub. No real macOS notification ever fires.
# BC-26 (claude-tools-v2cut.4): RECORD each invocation (the full argv, which
# carries the AppleScript `display notification "<body>" with title "<title>"`
# string) to $HARNESS_OUT/notify.log so the BC-26 -tree rig can assert the
# SELECTIVE-silence notify policy — which classes notify vs stay silent. A
# harmless no-op for every other rig (stdout unchanged, still exit 0).
if [[ -n "${HARNESS_OUT:-}" ]]; then
  printf '%s\n' "$*" >> "$HARNESS_OUT/notify.log" 2>/dev/null || true
fi
exit 0
