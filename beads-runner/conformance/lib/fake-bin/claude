#!/bin/bash
# Conformance harness — scripted `claude` stub (T1a, claude-tools-ooc).
#
# Emits stream-json on stdout exactly as run-beads-tasks.sh's parser expects
# (the runner redirects our stdout+stderr into STREAM_FILE), then exits with a
# controlled code. Behavior is read PER INVOCATION from $HARNESS_CLAUDE_PLAN
# (one behavior per line; invocations past the last line repeat the last line —
# end a plan with `success` to guarantee the queue drains and the runner
# reaches its BC-21 exit-0 terminal).
set -u

PLAN="${HARNESS_CLAUDE_PLAN:?HARNESS_CLAUDE_PLAN unset}"
CNT="${HARNESS_CLAUDE_COUNT:?HARNESS_CLAUDE_COUNT unset}"

# --version (preflight) — not an invocation.
for a in "$@"; do [[ "$a" == "--version" ]] && { echo "claude stub 0.0.0"; exit 0; }; done

# Extract the -p prompt.
prompt=""; i=1
for a in "$@"; do
  if [[ "$a" == "-p" ]]; then eval "prompt=\${$((i+1))}"; break; fi
  i=$((i+1))
done

# Beads id is inside the prompt: `beads issue <ID>: "..."`
bead_id=$(printf '%s' "$prompt" | sed -n 's/.*beads issue \([^ :]*\):.*/\1/p' | head -1)

# Record the exact prompt + argv (BC-38 worker-prompt / §7.6 guardrail reads these).
printf '%s' "$prompt" > "${HARNESS_OUT:-/dev/null}/last-prompt.txt" 2>/dev/null || true
printf '%s\n' "$@"     > "${HARNESS_OUT:-/dev/null}/last-argv.txt"   2>/dev/null || true

# Pick this invocation's behavior.
n=$(( $(cat "$CNT" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$CNT"
behavior=$(sed -n "${n}p" "$PLAN")
[[ -z "$behavior" ]] && behavior=$(tail -1 "$PLAN")

emit() { printf '%s\n' "$1"; }

emit '{"type":"assistant","message":"working"}'
emit '{"type":"tool_use","tool":"Bash"}'

case "$behavior" in
  success)
    [[ -n "$bead_id" ]] && bd close "$bead_id" >/dev/null 2>&1
    emit '{"type":"result","result":"done","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  noclose)            # exit 0 but bead left open  → BC-09 TASK_NOT_CLOSED
    emit '{"type":"result","result":"finished (forgot to close)","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  bdshow_empty)       # exit 0; harness makes bd-show status unparseable → BC-09 fail-open SUCCESS
    emit '{"type":"result","result":"done","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  overflow)           # BC-11 context overflow (errored result, prompt too long)
    emit '{"type":"result","result":"API Error: Prompt is too long","is_error":true,"stop_reason":"stop_sequence"}'
    exit 1 ;;

  overflow_then_fixed)
    # BC-14 overflow STORM driver, keyed on the BEAD (not invocation index):
    # every real task overflows on its first attempt (⇒ one analysis child
    # each); the analysis child resolves; the re-scoped retry then succeeds.
    # A positional `overflow overflow overflow success` plan is unsound here
    # because the fake `bd ready` interleaves analysis children into the queue
    # — an analysis child lands in an `overflow` slot, the BC-17 analysis-label
    # guard suppresses its grandchild, and a real task never overflows. Keying
    # on $BD_STORE/<id>/attempts makes the scenario order-independent so it
    # actually exercises "3 DISTINCT overflows ⇒ analysis-per-task, no breaker"
    # (BC-14's asserted behavior — unchanged; this fixes the driver only).
    if [[ "$bead_id" == htest-* ]]; then            # analysis child → resolve
      bd close "$bead_id" >/dev/null 2>&1
      emit '{"type":"result","result":"analyzed","is_error":false,"stop_reason":"end_turn"}'
      exit 0
    fi
    _att=$(cat "${BD_STORE:-/nonexistent}/$bead_id/attempts" 2>/dev/null || echo 1)
    if [[ "${_att:-1}" -le 1 ]]; then               # first attempt → overflow
      emit '{"type":"result","result":"API Error: Prompt is too long","is_error":true,"stop_reason":"stop_sequence"}'
      exit 1
    fi
    bd close "$bead_id" >/dev/null 2>&1             # re-scoped retry → success
    emit '{"type":"result","result":"done (re-scoped)","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  overflow_phrase_benign)   # BC-11 is_error guard: phrase present but NOT an error
    [[ -n "$bead_id" ]] && bd close "$bead_id" >/dev/null 2>&1
    emit '{"type":"result","result":"Note: the prompt is too long to inline, summarizing instead.","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  server_slow)        # BC-29: SERVER_ERROR but spanning >1s so ITER_TS differs
    sleep 2
    emit '{"type":"system","subtype":"api_retry","error":"server_error","error_status":500,"attempt":1,"max_retries":5}'
    emit '{"type":"result","result":"server error","is_error":true,"stop_reason":"end_turn"}'
    exit 1 ;;

  maxtok_result)      # BC-12 max-output-tokens via result stop_reason
    emit '{"type":"result","result":"truncated","is_error":true,"stop_reason":"max_tokens"}'
    exit 1 ;;

  maxtok_apiretry)    # BC-12 max-output-tokens via api_retry
    emit '{"type":"system","subtype":"api_retry","error":"max_output_tokens","error_status":400,"attempt":1,"max_retries":5}'
    emit '{"type":"result","result":"failed","is_error":true,"stop_reason":"end_turn"}'
    exit 1 ;;

  ratelimit)
    emit '{"type":"system","subtype":"api_retry","error":"rate_limit","error_status":429,"attempt":1,"max_retries":5}'
    emit '{"type":"result","result":"rate limited","is_error":true,"stop_reason":"end_turn"}'
    exit 1 ;;

  auth)
    emit '{"type":"system","subtype":"api_retry","error":"authentication_failed","error_status":401,"attempt":1,"max_retries":5}'
    emit '{"type":"result","result":"auth failed","is_error":true,"stop_reason":"end_turn"}'
    exit 1 ;;

  billing)
    emit '{"type":"system","subtype":"api_retry","error":"billing_error","error_status":402,"attempt":1,"max_retries":5}'
    emit '{"type":"result","result":"billing","is_error":true,"stop_reason":"end_turn"}'
    exit 1 ;;

  server)
    emit '{"type":"system","subtype":"api_retry","error":"server_error","error_status":500,"attempt":1,"max_retries":5}'
    emit '{"type":"result","result":"server error","is_error":true,"stop_reason":"end_turn"}'
    exit 1 ;;

  unknown)            # nonzero, no markers → UNKNOWN_FAILURE (generic branch)
    emit '{"type":"result","result":"died","is_error":true,"stop_reason":"end_turn"}'
    exit 1 ;;

  server500_terminal) # claude-tools-ntn: SDK retries EXHAUSTED — the terminal
    # failure is an ERRORED result with api_error_status:500 + "API Error: 500"
    # text and NO preceding system/api_retry event (the exact 2026-05-16 shape).
    # Pre-fix this falls through to UNKNOWN_FAILURE; post-fix ⇒ SERVER_ERROR.
    emit '{"type":"result","result":"API Error: 500 Internal server error","is_error":true,"api_error_status":500,"stop_reason":"end_turn"}'
    exit 1 ;;

  server500_benign)   # claude-tools-ntn NEGATIVE (is_error guard): a SUCCESSFUL
    # result that merely QUOTES "API Error: 500" in prose (is_error:false, bead
    # closed). Must classify SUCCESS — the new 5xx rule must NOT manufacture a
    # SERVER_ERROR from benign text (protects BC-25 / BC-11 is_error discipline).
    [[ -n "$bead_id" ]] && bd close "$bead_id" >/dev/null 2>&1
    emit '{"type":"result","result":"Investigated the log: saw API Error: 500 yesterday, now resolved.","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  rl_then_overflow)   # BC-10 multi-signal precedence: transient THEN terminal
    emit '{"type":"system","subtype":"api_retry","error":"rate_limit","error_status":429,"attempt":1,"max_retries":5}'
    emit '{"type":"result","result":"API Error: Prompt is too long","is_error":true,"stop_reason":"stop_sequence"}'
    exit 1 ;;

  overflow_then_maxtok) # BC-10: CONTEXT_OVERFLOW must beat MAX_OUTPUT_TOKENS
    emit '{"type":"result","result":"context_length_exceeded","is_error":true,"stop_reason":"max_tokens"}'
    exit 1 ;;

  auth_then_rl)       # BC-10: AUTH_FAILURE must beat RATE_LIMIT
    emit '{"type":"system","subtype":"api_retry","error":"rate_limit","error_status":429,"attempt":1,"max_retries":5}'
    emit '{"type":"system","subtype":"api_retry","error":"authentication_failed","error_status":401,"attempt":2,"max_retries":5}'
    emit '{"type":"result","result":"failed","is_error":true,"stop_reason":"end_turn"}'
    exit 1 ;;

  hang)               # BC-22 watchdog: alive, no stream output, idle.
    # `exec` so the watchdog's staged kill (SIGINT→SIGKILL on CLAUDE_PID)
    # lands on THIS sleep directly. A plain `sleep N; exit 0` would let the
    # wrapper bash defer the deferred-until-child SIGINT and then exit 0 —
    # the runner's classify_failure short-circuits on exit 0 (never reads the
    # signal file), masking the kill as TASK_NOT_CLOSED. A genuinely stuck
    # agent never voluntarily exits 0; it dies by the watchdog's signal
    # (nonzero), so WATCHDOG_KILL wins precedence. (Harness-mechanism fidelity
    # fix — the asserted behavior is unchanged.)
    exec sleep "${HARNESS_HANG_SECONDS:-86400}" ;;

  stuck_primary)      # §7.2 worker-driven STUCK (the forward gate; no marker today)
    if [[ -n "$bead_id" ]]; then
      bd update "$bead_id" --status=blocked >/dev/null 2>&1
      bd human "$bead_id" >/dev/null 2>&1
    fi
    emit '{"type":"result","result":"I need a human decision; blocked.","is_error":false,"stop_reason":"end_turn"}'
    exit "${WORKER_STUCK_EXIT:-7}" ;;

  stuck_primary_exit0)  # claude-tools-1vnx: the EXIT-0 human-decision fork — the
    # m3xi thrash vector. A COMPLIANT worker takes the deterministic bd path
    # (status=blocked + a real `human` label + a structured ask in notes) but then
    # ENDS ITS TURN, so `claude -p` exits 0 — NOT the WORKER_STUCK_EXIT(7) sentinel
    # the `stuck_primary` plan uses (research Q4: a capable headless worker exits 0,
    # the bd side effects ARE the signal). classify_failure ⇒ TASK_NOT_CLOSED; the
    # runner must NOT reset --status=open / spawn an analysis child — the §7.3
    # preempt OR the claude-tools-1vnx belt pins it blocked-for-human.
    if [[ -n "$bead_id" ]]; then
      bd update "$bead_id" --status=blocked >/dev/null 2>&1
      bd label add "$bead_id" human >/dev/null 2>&1
      bd update "$bead_id" --append-notes="TL;DR: need a human decision. The ask: pick A or B." >/dev/null 2>&1
    fi
    emit '{"type":"result","result":"I left it status=blocked + human and wrote the A/B ask.","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  # ── T1b additions (claude-tools-crq) ─────────────────────────────────────────

  subagent_err_then_success)
    # BC-25 / BC-28: a tool_result is_error:true matching the subagent-not-found
    # pattern, but the agent recovers and CLOSES the bead (exit 0 ⇒ SUCCESS).
    # scan_tool_errors must STILL surface a TOOL_ERROR incident+note (side-effect
    # only, classification unchanged); SUCCESS preserves NO stream (BC-28).
    emit '{"type":"tool_result","is_error":true,"content":"Error: Agent type '\''code-reviewer-x'\'' not found"}'
    [[ -n "$bead_id" ]] && bd close "$bead_id" >/dev/null 2>&1
    emit '{"type":"result","result":"recovered inline; done","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  benign_err_then_success)
    # BC-25 negative (pattern-NOT-count): a tool_result is_error:true that is a
    # ROUTINE probe (Read-on-missing-file) — matches NONE of the three signature
    # patterns. Raw-count logic would flag it; pattern logic must NOT. Bead
    # closed ⇒ SUCCESS, and zero TOOL_ERROR incidents/notes.
    emit '{"type":"tool_result","is_error":true,"content":"File does not exist: /tmp/nope.txt"}'
    emit '{"type":"tool_result","is_error":true,"content":"No matches found"}'
    [[ -n "$bead_id" ]] && bd close "$bead_id" >/dev/null 2>&1
    emit '{"type":"result","result":"done (benign probes only)","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  server_then_hang)
    # BC-28 edge: the watchdog kills the process (writes WATCHDOG_KILL=1 + a
    # PROC_SNAPSHOT) but an earlier, more-decisive SERVER_ERROR signal wins
    # classification (§7.1 order: SERVER_ERROR before WATCHDOG_KILL). The proc
    # snapshot keys on *classification* == WATCHDOG_KILL, so it must be DELETED;
    # the stream IS preserved (SERVER_ERROR is a serious class).
    emit '{"type":"system","subtype":"api_retry","error":"server_error","error_status":500,"attempt":1,"max_retries":5}'
    exec sleep "${HARNESS_HANG_SECONDS:-86400}" ;;

  success_touch_old)
    # BC-30 driver: on its FIRST invocation, create an artifact UNDER LOG_DIR
    # with an ancient mtime, mid-run (after the single startup prune). If
    # rotation were per-iteration it would delete this before the next task;
    # since rotation is once-per-invocation it must SURVIVE to run end. Path is
    # relative to the runner's cwd (LOG_DIR=.beads/runner-logs).
    if [[ "$n" -eq 1 ]]; then
      mkdir -p .beads/runner-logs 2>/dev/null || true
      : > ".beads/runner-logs/${HARNESS_TOUCH_OLD:-midrun-OLD.jsonl}" 2>/dev/null || true
      touch -t 200001010000 ".beads/runner-logs/${HARNESS_TOUCH_OLD:-midrun-OLD.jsonl}" 2>/dev/null || true
    fi
    [[ -n "$bead_id" ]] && bd close "$bead_id" >/dev/null 2>&1
    emit '{"type":"result","result":"done","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  stuck_backstop_pd)
    # §7.2 backstop A (zero model trust): the worker slipped — it did NOT close
    # the bead and exits 0/is_error:false (a FALSE success) but the final result
    # carries permission_denials[] for AskUserQuestion. Post-rewrite the runner
    # backstop MUST classify STUCK_NEEDS_HUMAN (overriding the false exit-0) and
    # itself drive the bead to blocked + bd human (§7.3). Current script never
    # scans permission_denials ⇒ TASK_NOT_CLOSED (the forward gap).
    emit '{"type":"result","result":"I should ask the user.","is_error":false,"stop_reason":"end_turn","permission_denials":[{"tool":"AskUserQuestion"}]}'
    exit 0 ;;

  stuck_backstop_plan)
    # §7.2 backstop B: the EnterPlanMode silent-no-op residual gap — a
    # "Entered plan mode." tool_result in the stream, false exit-0, bead not
    # closed. Post-rewrite ⇒ STUCK_NEEDS_HUMAN + bead blocked + bd human.
    emit '{"type":"tool_result","content":"Entered plan mode. Waiting for approval."}'
    emit '{"type":"result","result":"plan ready for approval","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  rate_limit_event_allowed)
    # BC-61: a SUBSCRIPTION-window snapshot with status=allowed — collapses to ONE
    # terse `[rate_limit] … ok` line, emits NO classification marker, and the bead
    # closes (⇒ SUCCESS, classification unaffected). NOT a 429 (that is `ratelimit`).
    emit '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed","rateLimitType":"five_hour","resetsAt":1900000000}}'
    [[ -n "$bead_id" ]] && bd close "$bead_id" >/dev/null 2>&1
    emit '{"type":"result","result":"done","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  rate_limit_event_warning)
    # BC-61: status=allowed_warning ⇒ a LOUD one-line `[rate_limit:WARN]` with
    # utilization/threshold; still no classification marker, bead closes (SUCCESS).
    emit '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed_warning","rateLimitType":"seven_day","utilization":0.92,"surpassedThreshold":0.8,"resetsAt":1900000000}}'
    [[ -n "$bead_id" ]] && bd close "$bead_id" >/dev/null 2>&1
    emit '{"type":"result","result":"done","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  rate_limit_event_quota)
    # BC-61 forward-compat: status=rejected ⇒ a `[rate_limit:QUOTA]` line PLUS a
    # RATE_LIMIT_QUOTA=<type> signal marker (not a classifier input — classification
    # is still driven by the result/exit, so the bead closes SUCCESS). Never observed
    # today; this exercises the reserved branch.
    emit '{"type":"rate_limit_event","rate_limit_info":{"status":"rejected","rateLimitType":"seven_day","resetsAt":1900000000}}'
    [[ -n "$bead_id" ]] && bd close "$bead_id" >/dev/null 2>&1
    emit '{"type":"result","result":"done","is_error":false,"stop_reason":"end_turn"}'
    exit 0 ;;

  *)
    emit '{"type":"result","result":"unrecognized plan behavior","is_error":true,"stop_reason":"end_turn"}'
    exit 1 ;;
esac
