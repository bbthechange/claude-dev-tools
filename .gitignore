
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Cloudflare local-emulation artifacts (wrangler dev / pages dev — LOCAL only,
# no account). Regenerated on every serve; never committed. Mirrors the intent
# of beads-runner/cf/.gitignore for the CF.10 pages-dev serve, which runs
# `wrangler pages dev` inside the FROZEN web/board + web/inbox trees.
.wrangler/

tmp/

beads-runner/mocks/

.beads/runner-logs/

# B5 (claude-tools-uu1) MCP-server SIGKILL probe sandbox — local, throwaway
.b5-probe/

# mcp-askbrian/ — local node_modules (re-installed on demand) and the
# test-*.sh scratch dir (CO_STORE for the in-process bash store).
mcp-askbrian/node_modules/
mcp-askbrian/.test-scratch/
mcp-askbrian/package-lock.json

